# Jitsi Meet server domain
# Use your own self-hosted community Jitsi domain (e.g. meet.balkrishnapokharel.com.np or meet.jit.si)
NEXT_PUBLIC_JITSI_DOMAIN=meet.balkrishnapokharel.com.np

# Salt string used for PBKDF2 room name and lock key derivation.
# Changing this invalidates all existing meeting password mappings.
NEXT_PUBLIC_ROOM_SALT=change-me-to-a-secure-random-salt-string-for-your-deployment

# SHA-256 hash (in hex) of your special admin password for creating meetings on /admin.
# To generate your hash, run in your terminal:
#   echo -n "YourSpecialAdminPassword" | shasum -a 256
#
# Default hash below is for: admin-secret-passphrase
NEXT_PUBLIC_ADMIN_PASSWORD_HASH=0937b275bfb7eb00c85b5d19a27e7bebeafba6d3e8958b431766a5e173e6cf1e
